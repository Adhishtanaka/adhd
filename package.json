{
  "name": "adhd-cli",
  "version": "0.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adhishtanaka/adhd.git"
  },
  "type": "module",
  "module": "src/web.ts",
  "bin": {
    "adhd": "bin/adhd.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run build:web && bun run src/web.ts",
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "build": "bun run build:web && bun build --compile --outfile adhd src/web.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build:web"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.91",
    "@ai-sdk/deepseek": "^1.0.20",
    "@ai-sdk/google": "^2.0.85",
    "@ai-sdk/openai-compatible": "^1.0.46",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "12",
    "ai": "^5",
    "htmx.org": "2",
    "leaflet": "1",
    "marked": "^15",
    "mermaid": "11",
    "react": "18",
    "react-dom": "18",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "3",
    "typescript": "^5",
    "vite": "5"
  }
}
