direction: right

classes: {
  surface: {
    style.fill: "#252525"
    style.stroke: "#454545"
    style.font-color: "#E8E8E8"
    style.border-radius: 8
  }
  group: {
    style.fill: "#1D1D1D"
    style.stroke: "#4B4B4B"
    style.font-color: "#F1F1F1"
    style.border-radius: 10
  }
  muted: {
    style.fill: "#222222"
    style.stroke: "#3C3C3C"
    style.font-color: "#AAAAAA"
    style.border-radius: 6
  }
  primary: {
    style.fill: "#245D9E"
    style.stroke: "#3972AE"
    style.font-color: "#FFFFFF"
    style.border-radius: 7
  }
}

user: You {
  shape: person
  style.fill: "#245D9E"
  style.stroke: "#3972AE"
  style.font-color: "#FFFFFF"
}

browser: Browser UI {
  class: surface
  label: "Browser UI\nchat · settings · flows"
}

local: Local adhd process {
  class: group
  agent: Agent loop {
    class: primary
    label: "Agent loop\nstream · plan · retry"
  }
  tools: Tool runtime {
    class: surface
    label: "Tool runtime\nexecute · approve · render"
  }
  state: Local state {
    class: muted
    memory: Memory {class: muted}
    schedules: Scheduler {class: muted}
    flows: Flows {class: muted}
  }
  agent -> tools: tool calls {
    style.stroke: "#5D8FC5"
    style.font-color: "#8DB4DE"
  }
  agent <-> state: context {
    style.stroke: "#666666"
    style.font-color: "#999999"
  }
}

models: Model providers {
  class: group
  selected: Selected model {class: primary}
  fallback: Fallback model {class: muted}
  compatible: Compatible APIs {class: muted}
}

world: Permissioned access {
  class: group
  files: Files + shell {class: surface}
  web: Search + browser {class: surface}
  mcp: MCP servers {class: surface}
}

user -> browser: prompt {
  style.stroke: "#777777"
  style.font-color: "#A8A8A8"
}
browser -> local.agent: SSE stream {
  style.stroke: "#3972AE"
  style.font-color: "#8DB4DE"
}
local.agent <-> models: model API {
  style.stroke: "#3972AE"
  style.font-color: "#8DB4DE"
}
local.tools <-> world: approved actions {
  style.stroke: "#777777"
  style.font-color: "#A8A8A8"
}
